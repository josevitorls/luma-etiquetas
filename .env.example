# Copie este arquivo para ".env" e preencha com as SUAS credenciais do Lu.ma.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
#
# Estas são as credenciais da SUA conta Lu.ma — as mesmas que você usa para
# entrar em https://luma.com/signin. A conta precisa ser admin/host do evento
# cujos convidados você quer listar e imprimir.

LUMA_EMAIL=voce@exemplo.com
LUMA_PASSWORD=suaSenhaDoLuma
