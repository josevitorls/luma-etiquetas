{
  "name": "luma-etiquetas",
  "version": "1.0.0",
  "description": "Gestão de convidados do Lu.ma + impressão de etiquetas de crachá (PDF). Cada adotante usa a própria conta Lu.ma.",
  "type": "module",
  "bin": {
    "luma-etiquetas": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "assets/fonts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "luma",
    "lu.ma",
    "badge",
    "etiqueta",
    "cracha",
    "pdf",
    "events",
    "check-in"
  ],
  "license": "MIT",
  "author": "josevitorls",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josevitorls/luma-etiquetas.git"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
